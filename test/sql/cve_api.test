# name: test/sql/cve_api.test
# description: NVD 2.0 table functions against the local mock server
# group: [vgi_cve]

require-env VGI_CVE_WORKER

require-env VGI_CVE_TEST_URL

statement ok
LOAD vgi;

statement ok
ATTACH 'cve' AS cve (TYPE vgi, LOCATION '${VGI_CVE_WORKER}');

# ---- cve(): fetch one CVE by ID via the mock base_url ----

query I
SELECT count(*) FROM cve.cve('CVE-2021-44228', base_url := '${VGI_CVE_TEST_URL}');
----
1

query TRTT
SELECT id, cvss_score, cvss_severity, cwe
FROM cve.cve('CVE-2021-44228', base_url := '${VGI_CVE_TEST_URL}');
----
CVE-2021-44228	10.0	CRITICAL	CWE-502

# The fetched vector recomputes to the same score with the offline scalar.
query T
SELECT ROUND(cve.cvss_base_score(cvss_vector), 1)
FROM cve.cve('CVE-2021-44228', base_url := '${VGI_CVE_TEST_URL}');
----
10.0

# ---- cve_search(): paginated keyword search ----

query I
SELECT count(*) FROM cve.cve_search('log4j', base_url := '${VGI_CVE_TEST_URL}');
----
3

query I
SELECT count(*) FROM cve.cve_search('log4j', base_url := '${VGI_CVE_TEST_URL}')
WHERE cvss_severity = 'CRITICAL';
----
2

# ---- cpe_cves(): CVEs for a CPE name, including a NULL-score record ----

query I
SELECT count(*) FROM cve.cpe_cves('cpe:2.3:a:apache:log4j:2.14.1:*:*:*:*:*:*:*', base_url := '${VGI_CVE_TEST_URL}');
----
3

# A CVE with no CVSS metrics surfaces a NULL score.
query I
SELECT count(*) FROM cve.cpe_cves('cpe:2.3:a:apache:log4j:2.14.1:*:*:*:*:*:*:*', base_url := '${VGI_CVE_TEST_URL}')
WHERE cvss_score IS NULL;
----
1

# ...and NULL severity (not an empty string) on that same unscored record.
query TII
SELECT cve_id, cvss_severity IS NULL, cvss_score IS NULL
FROM cve.cpe_cves('cpe:2.3:a:apache:log4j:2.14.1:*:*:*:*:*:*:*', base_url := '${VGI_CVE_TEST_URL}')
ORDER BY cve_id;
----
CVE-2021-44228	false	false
CVE-2021-45046	false	false
CVE-2099-00000	true	true

# Composed: flag which keyword-search hits NVD lists against the installed CPE.
query TRTI
SELECT s.id, s.cvss_score, s.cvss_severity, p.cve_id IS NOT NULL AS affects_2_14_1
FROM cve.main.cve_search('log4j', base_url := '${VGI_CVE_TEST_URL}') s
LEFT JOIN cve.main.cpe_cves('cpe:2.3:a:apache:log4j:2.14.1:*:*:*:*:*:*:*', base_url := '${VGI_CVE_TEST_URL}') p ON p.cve_id = s.id
ORDER BY s.cvss_score DESC NULLS LAST, s.id;
----
CVE-2021-44228	10.0	CRITICAL	true
CVE-2022-22965	9.8	CRITICAL	false
CVE-2014-0160	7.5	HIGH	false

# cpe_cves surfaces the description and publication date alongside the scoring.
query TTR
SELECT cve_id, description, cvss_score
FROM cve.cpe_cves('cpe:2.3:a:apache:log4j:2.14.1:*:*:*:*:*:*:*', base_url := '${VGI_CVE_TEST_URL}')
WHERE cve_id = 'CVE-2021-44228';
----
CVE-2021-44228	Apache Log4j2 2.0-beta9 through 2.15.0 JNDI features used in configuration, log messages, and parameters do not protect against attacker controlled LDAP and other JNDI related endpoints.	10.0

# ---- unknown CVE -> clean error (mock returns 404) ----

statement error
SELECT * FROM cve.cve('CVE-0000-99999', base_url := '${VGI_CVE_TEST_URL}');
----

# Composed (published example): re-score the fetched vector offline and check
# it reproduces the record's score.
query TTRRI
SELECT id, cvss_vector, cvss_score AS nvd_score, cve.main.cvss_base_score(cvss_vector) AS recomputed_score, cvss_score = cve.main.cvss_base_score(cvss_vector) AS scores_agree
FROM cve.main.cve('CVE-2021-44228', base_url := '${VGI_CVE_TEST_URL}') ORDER BY id;
----
CVE-2021-44228	CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H	10.0	10.0	true
